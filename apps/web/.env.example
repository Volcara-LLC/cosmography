# Generate at least 32 random characters; never reuse the example text as a secret.
IDENTITY_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-characters
IDENTITY_HMAC_KEY_VERSION=v1

# During rotation, retain the prior key and version until every retained account
# has migrated. Remove both lines together only after the migration window closes.
IDENTITY_HMAC_PREVIOUS_SECRET=
IDENTITY_HMAC_PREVIOUS_KEY_VERSION=

# Local development may bypass the contest-only gate. Hosted judging must use
# shared-code and must store JUDGE_ACCESS_CODE and JUDGE_COOKIE_SECRET only as
# protected Cloudflare secrets. Never put either secret value in this file.
JUDGE_ACCESS_MODE=disabled
JUDGE_COOKIE_TTL_SECONDS=1814400
